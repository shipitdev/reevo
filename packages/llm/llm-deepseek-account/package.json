    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/cosmokit": "workspace:~",
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@reevo/dsh-llm": "workspace:*",
    "@reevo/dsh-llm-deepseek": "workspace:*",
    "@reevo/dsh-launch-environment": "workspace:*",
    "@reevo/dsh-deepseek-account": "workspace:*",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@reevo/dsh-agent": "workspace:*",
    "@reevo/dsh-deepseek-auth": "workspace:*"
  },
  "devDependencies": {
    "@reevo/dsh-brand": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~",
    "@reevo/dsh-llm": "workspace:*",
    "@reevo/dsh-llm-deepseek": "workspace:*",
    "@reevo/dsh-launch-environment": "workspace:*",
    "@reevo/dsh-deepseek-account": "workspace:*",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@reevo/dsh-llm-deepseek-api-key": "workspace:*",
    "@reevo/dsh-timeout": "workspace:*",
    "@reevo/dsh-agent": "workspace:*",
    "@reevo/dsh-deepseek-auth": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@reevo/dsh-deepseek-account": {
      "optional": true
    },
    "@deepseek-ai/cordis-plugin-loader": {
      "optional": true
    },
    "@reevo/dsh-agent": {
      "optional": true
    }
  }
