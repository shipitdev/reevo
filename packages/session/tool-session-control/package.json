{
  "name": "@reevo/dsh-tool-session-control",
  "description": "Send model-authored messages to ordinary Web Sessions with acceptance receipts",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/session/tool-session-control"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@reevo/dsh-api-session-controller": "workspace:*",
    "@reevo/dsh-brand": "workspace:*",
    "@reevo/dsh-error": "workspace:*",
    "@reevo/dsh-llm": "workspace:*",
    "@reevo/dsh-session": "workspace:*",
    "@reevo/dsh-subagent": "workspace:*",
    "@reevo/dsh-tools": "workspace:*",
    "@reevo/dsh-workspace": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@reevo/dsh-agent": "workspace:*",
    "@reevo/dsh-agent-loop-testkit": "workspace:*",
    "@reevo/dsh-api-session-controller": "workspace:*",
    "@reevo/dsh-brand": "workspace:*",
    "@reevo/dsh-error": "workspace:*",
    "@reevo/dsh-llm": "workspace:*",
    "@reevo/dsh-session": "workspace:*",
    "@reevo/dsh-subagent": "workspace:*",
    "@reevo/dsh-tool-testkit": "workspace:*",
    "@reevo/dsh-tools": "workspace:*",
    "@reevo/dsh-typert-protocol": "workspace:*",
    "@reevo/dsh-workspace": "workspace:*"
  }
}
