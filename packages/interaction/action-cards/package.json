{
  "name": "@reevo/dsh-action-cards",
  "description": "Optional action cards below answers: card state, user actions and status notices",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/interaction/action-cards"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@reevo/dsh-typert-protocol": "workspace:*",
    "@reevo/dsh-llm": "workspace:*",
    "@reevo/dsh-session": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@reevo/dsh-typert-protocol": "workspace:*",
    "@reevo/dsh-llm": "workspace:*",
    "@reevo/dsh-agent": "workspace:*",
    "@reevo/dsh-agent-loop": "workspace:*",
    "@reevo/dsh-agent-loop-testkit": "workspace:*",
    "@reevo/dsh-session": "workspace:*",
    "@reevo/dsh-session-projection": "workspace:*",
    "@reevo/dsh-api-remote-access": "workspace:*",
    "@reevo/dsh-sandbox-policy": "workspace:*",
    "@reevo/dsh-util-values": "workspace:*",
    "@reevo/dsh-skill": "workspace:*",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@deepseek-ai/cosmokit": "workspace:~"
  },
  "dependencies": {
    "@reevo/dsh-brand": "workspace:*",
    "zod": "4.6.6",
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "lib/typert.remote-client.d.ts.map",
    "src"
  ]
}
