{
  "name": "@reevo/dsh-jobs",
  "description": "Background job registry (ctx.jobs) for the DeepSeek Harness — shared ids, owner isolation, polling, cancellation, and completion listeners for long-running tool work",
  "version": "0.2.3-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/jobs/jobs"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./view": {
      "types": "./lib/types/view.d.ts",
      "default": "./lib/types/view.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@reevo/dsh-agent": "workspace:*",
    "@reevo/dsh-error": "workspace:*",
    "@reevo/dsh-session": "workspace:*",
    "@reevo/dsh-workspace": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~"
  },
  "peerDependenciesMeta": {
    "@reevo/dsh-workspace": {
      "optional": true
    }
  },
  "devDependencies": {
    "@reevo/dsh-agent": "workspace:*",
    "@reevo/dsh-brand": "workspace:*",
    "@reevo/dsh-error": "workspace:*",
    "@reevo/dsh-session": "workspace:*",
    "@reevo/dsh-workspace": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~"
  }
}
